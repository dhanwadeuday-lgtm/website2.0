# Use ONE of these pairs, depending on where your Redis DB lives.

# Option A — Vercel KV (Vercel dashboard → your project → Storage → Create KV database)
# Vercel fills these in automatically once you connect the KV database to this project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Option B — standalone Upstash Redis (upstash.com → free tier → REST API section)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
